# Docker Compose settings. Copy to .env (gitignored) and edit.

# Absolute path to your Obsidian vault on the host
VAULT_DIR=/home/you/vault

# Owner of the vault folder on the host (run: id -u ; id -g)
PUID=1000
PGID=1000

# Optional: pin Claude Code (blank/latest = newest at build time)
CLAUDE_CODE_VERSION=latest

# --- LiveSync profile only ---
# Folder holding the LiveSync CLI's local database and .livesync/settings.json
LIVESYNC_DB_DIR=./livesync-db
# Image tag: match your Obsidian LiveSync plugin version, e.g. 1.0.43-cli
LIVESYNC_TAG=latest
# Source ref when building from source (compose.livesync-build.yaml)
LIVESYNC_REF=main
