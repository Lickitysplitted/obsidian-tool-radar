# Copy to ~/.config/vault-research.env, fill in, then: chmod 600 ~/.config/vault-research.env
# The real file holds a credential. Never commit it (it's gitignored).

# --- Auth: set ONE of these ---
# Claude subscription: run `claude setup-token` on any machine with a browser, paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# Or an Anthropic API key (billed per use):
# ANTHROPIC_API_KEY=

# --- Optional overrides (defaults shown) ---
# VAULT_PATH=/home/<you>/vault
# INBOX_NOTE=Research Queue.md
# RESEARCH_DIR=Research
# LAB_PROFILE_NOTE=Lab Profile.md
# DEEPSCOPE_DIR=/home/<you>/.claude/skills/deepscope
# DEEPSCOPE=on
# CLAUDE_MODEL=          # blank = Claude Code default; e.g. sonnet (cheaper) or opus (deeper)
# MAX_TURNS=80
# RESEARCH_TIMEOUT=2400
# MAX_ATTEMPTS=3
# SETTLE_SECONDS=20
# POLL_SECONDS=10
